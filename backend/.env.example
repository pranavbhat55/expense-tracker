# Required
DATABASE_URL="postgresql://user:password@localhost:5432/expense_tracker"
JWT_SECRET="replace-with-a-long-random-string"

# Optional: invitation emails. Without SMTP_URL the app works and owners share the invite link by hand.
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
# EMAIL_FROM="Expenso <no-reply@yourcompany.com>"
# Public URL of the frontend, used to build the link inside invitation emails
# APP_URL="https://app.yourcompany.com"
